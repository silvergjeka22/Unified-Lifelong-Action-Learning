\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-task accuracy across the whole stream. \emph  {Left (Naive):} each old task's line collapses the moment a new task is learned---catastrophic forgetting made visible. \emph  {Right (Replay):} rehearsing a few old clips per class keeps every line high, so the final model still knows the earliest classes.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:forget}{{4}{5}{Per-task accuracy across the whole stream. \emph {Left (Naive):} each old task's line collapses the moment a new task is learned---catastrophic forgetting made visible. \emph {Right (Replay):} rehearsing a few old clips per class keeps every line high, so the final model still knows the earliest classes}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Distillation into the MobileNetV3-Small student (20-class group-disjoint test). All students share one budget, seed, and initialisation; only the transfer term differs.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:kd}{{IV}{5}{Distillation into the MobileNetV3-Small student (20-class group-disjoint test). All students share one budget, seed, and initialisation; only the transfer term differs}{table.4}{}}
