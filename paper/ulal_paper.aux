\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Stage 5: three starting points and one shared adaptation}, top to bottom. The plain student (S5.0), the student after normal training on 40 other sports (S5.1, the control), and the student after MAML on the same sports (S5.2, violet: inner/outer loop) are each adapted in the same way: 8 clips of 5 new sports, a head grown from 20 to 25 classes, with optional replay (orange) and optional LwF (dashed). Red dashed: only the last 4 blocks, LSTM and head are trained before adaptation.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:meta}{{6}{8}{\textbf {Stage 5: three starting points and one shared adaptation}, top to bottom. The plain student (S5.0), the student after normal training on 40 other sports (S5.1, the control), and the student after MAML on the same sports (S5.2, violet: inner/outer loop) are each adapted in the same way: 8 clips of 5 new sports, a head grown from 20 to 25 classes, with optional replay (orange) and optional LwF (dashed). Red dashed: only the last 4 blocks, LSTM and head are trained before adaptation}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces Stage 6: test accuracy (\%) on the 10 base classes (212 test clips, chance 10\%) with $k$ training clips per class. ``Trained'' counts the trainable parameters; the CLIP image encoder ($\approx $88M) is frozen. --: not run.}}{8}{table.9}\protected@file@percent }
\newlabel{tab:clip}{{IX}{8}{Stage 6: test accuracy (\%) on the 10 base classes (212 test clips, chance 10\%) with $k$ training clips per class. ``Trained'' counts the trainable parameters; the CLIP image encoder ($\approx $88M) is frozen. --: not run}{table.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Stage 6: few-shot learning with a frozen CLIP encoder}, top to bottom. Left: our ResNet50+LSTM, its LSTM and head trained on the same $k$ clips. Right: the frozen CLIP image encoder (dashed) turns every clip into one 512-d feature $f$ (average of its 16 frames), and three classifiers use it: text + visual prototypes (S6.1; $t_c$ from the class name, $m_c$ the mean feature of the $k$ clips of class $c$), a linear probe (S6.2), and a small MLP adapter (S6.3). Blue: trained on the $k$ clips. Bottom: test accuracy (\%), from 1 to 16 clips per class where the whole sweep was run.}}{9}{figure.7}\protected@file@percent }
\newlabel{fig:clip}{{7}{9}{\textbf {Stage 6: few-shot learning with a frozen CLIP encoder}, top to bottom. Left: our ResNet50+LSTM, its LSTM and head trained on the same $k$ clips. Right: the frozen CLIP image encoder (dashed) turns every clip into one 512-d feature $f$ (average of its 16 frames), and three classifiers use it: text + visual prototypes (S6.1; $t_c$ from the class name, $m_c$ the mean feature of the $k$ clips of class $c$), a linear probe (S6.2), and a small MLP adapter (S6.3). Blue: trained on the $k$ clips. Bottom: test accuracy (\%), from 1 to 16 clips per class where the whole sweep was run}{figure.7}{}}
