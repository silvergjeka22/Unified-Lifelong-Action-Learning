\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Few-shot meta-adaptation: 20 base + 5 new (5-way), identical adaptation for every arm, ranked by harmonic mean. Measured at 8 clips/class, 5 epochs. ``Bal.''\ is the balanced mean, ``Harm.''\ the harmonic mean of Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:harm}\unskip \@@italiccorr )}}.}}{6}{table.5}\protected@file@percent }
\newlabel{tab:meta}{{V}{6}{Few-shot meta-adaptation: 20 base + 5 new (5-way), identical adaptation for every arm, ranked by harmonic mean. Measured at 8 clips/class, 5 epochs. ``Bal.''\ is the balanced mean, ``Harm.''\ the harmonic mean of Eq.~\eqref {eq:harm}}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces New-class accuracy and base retention per method. Inits with no protection (MAML, fine-tune, no-meta) learn new classes but wipe the base; adding replay recovers the base, and the MAML init gives the highest new-class accuracy among the protected arms---so MAML+replay tops the balanced ranking.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:metacompare}{{5}{6}{New-class accuracy and base retention per method. Inits with no protection (MAML, fine-tune, no-meta) learn new classes but wipe the base; adding replay recovers the base, and the MAML init gives the highest new-class accuracy among the protected arms---so MAML+replay tops the balanced ranking}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VIII-A}}Cross-stage synthesis}{6}{subsection.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces New-class accuracy versus the number of support clips. MAML's advantage is largest at \textbf  {1 clip} (MAML $\approx $0.26 while every other init is near 0) and narrows as clips grow: meta-learning helps most exactly when data is scarce.}}{6}{figure.6}\protected@file@percent }
\newlabel{fig:sweep}{{6}{6}{New-class accuracy versus the number of support clips. MAML's advantage is largest at \textbf {1 clip} (MAML $\approx $0.26 while every other init is near 0) and narrows as clips grow: meta-learning helps most exactly when data is scarce}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces MAML meta-training curve: meta query accuracy rises from 0.83 to 0.98 over 8 epochs, confirming the initialisation is genuinely being shaped rather than left at the student's starting point.}}{6}{figure.7}\protected@file@percent }
\newlabel{fig:metacurve}{{7}{6}{MAML meta-training curve: meta query accuracy rises from 0.83 to 0.98 over 8 epochs, confirming the initialisation is genuinely being shaped rather than left at the student's starting point}{figure.7}{}}
