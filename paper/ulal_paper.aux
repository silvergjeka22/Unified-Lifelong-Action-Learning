\@writefile{toc}{\contentsline {section}{\numberline {IV}Stage 1 --- Data Split and Leakage}{2}{section.4}\protected@file@percent }
\newlabel{sec:data}{{IV}{2}{Stage 1 --- Data Split and Leakage}{section.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The ULAL pipeline.} Each stage answers one question (top), transforms the model (middle), and reports a headline result (bottom). UCF101 video is first split by source group so that no recording leaks across train and test (Stage\nobreakspace  {}1). A ResNet50+LSTM teacher is trained on the base classes (Stage\nobreakspace  {}2), extended to new classes by continual learning with a growing classifier head (Stage\nobreakspace  {}3), compressed into a small MobileNet student by knowledge distillation (Stage\nobreakspace  {}4), and finally adapted to brand-new classes from only a few clips with MAML plus replay (Stage\nobreakspace  {}5). The dashed red arrows mark the \emph  {moving freeze boundary}: from Stage\nobreakspace  {}3 onward the lower backbone is frozen to protect old features while the upper blocks, LSTM, and head remain trainable. Each stage supplies an ability the next one needs.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{3}{\textbf {The ULAL pipeline.} Each stage answers one question (top), transforms the model (middle), and reports a headline result (bottom). UCF101 video is first split by source group so that no recording leaks across train and test (Stage~1). A ResNet50+LSTM teacher is trained on the base classes (Stage~2), extended to new classes by continual learning with a growing classifier head (Stage~3), compressed into a small MobileNet student by knowledge distillation (Stage~4), and finally adapted to brand-new classes from only a few clips with MAML plus replay (Stage~5). The dashed red arrows mark the \emph {moving freeze boundary}: from Stage~3 onward the lower backbone is frozen to protect old features while the upper blocks, LSTM, and head remain trainable. Each stage supplies an ability the next one needs}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The shared recogniser.} The backbone $\phi $ runs on each of the 16 frames; an LSTM summarises the sequence into a 256-d clip feature; a growing head classifies. The moving freeze boundary (dashed) decides how deep the trainable region reaches at each stage---broad early on, then narrowed to the upper backbone, LSTM, and head to protect old features.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:arch}{{2}{3}{\textbf {The shared recogniser.} The backbone $\phi $ runs on each of the 16 frames; an LSTM summarises the sequence into a 256-d clip feature; a growing head classifies. The moving freeze boundary (dashed) decides how deep the trainable region reaches at each stage---broad early on, then narrowed to the upper backbone, LSTM, and head to protect old features}{figure.2}{}}
