\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The ULAL architecture.} One column per stage, read top to bottom; the grey arrows hand the result of each stage to the part of the next stage it feeds (clips to the teacher, the 10-class teacher to continual learning, the 30-class teacher to distillation, the student to meta-learning, the MAML student to the real-video test). Every column uses the winner of its study (Sections\nobreakspace  {}\ref  {sec:data}--\ref  {sec:meta}); Section\nobreakspace  {}\ref  {sec:ulal} walks through the whole pipeline. Grey: data; blue: trained; dashed: frozen; orange: stored old clips; violet: meta-learning; green: classifier head; red dashed: freeze boundary.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{3}{\textbf {The ULAL architecture.} One column per stage, read top to bottom; the grey arrows hand the result of each stage to the part of the next stage it feeds (clips to the teacher, the 10-class teacher to continual learning, the 30-class teacher to distillation, the student to meta-learning, the MAML student to the real-video test). Every column uses the winner of its study (Sections~\ref {sec:data}--\ref {sec:meta}); Section~\ref {sec:ulal} walks through the whole pipeline. Grey: data; blue: trained; dashed: frozen; orange: stored old clips; violet: meta-learning; green: classifier head; red dashed: freeze boundary}{figure.1}{}}
