\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-task accuracy across the whole stream. \emph  {Left (Naive):} each old task's line collapses the moment a new task is learned---catastrophic forgetting. \emph  {Right (Replay):} rehearsing a few old clips keeps every line high.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:forget}{{3}{4}{Per-task accuracy across the whole stream. \emph {Left (Naive):} each old task's line collapses the moment a new task is learned---catastrophic forgetting. \emph {Right (Replay):} rehearsing a few old clips keeps every line high}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Few-shot meta-adaptation: 20 base + 5 new (5-way), identical adaptation for all arms, ranked by harmonic mean. Measured at 8 clips/class, 5 epochs.}}{4}{table.5}\protected@file@percent }
\newlabel{tab:meta}{{V}{4}{Few-shot meta-adaptation: 20 base + 5 new (5-way), identical adaptation for all arms, ranked by harmonic mean. Measured at 8 clips/class, 5 epochs}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces New-class accuracy and base retention per method. Inits with no protection (MAML, fine-tune, no-meta) learn new classes but wipe the base; adding replay recovers the base, and the MAML init gives the highest new-class accuracy among the protected arms---so MAML+replay tops the balanced ranking.}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:metacompare}{{4}{4}{New-class accuracy and base retention per method. Inits with no protection (MAML, fine-tune, no-meta) learn new classes but wipe the base; adding replay recovers the base, and the MAML init gives the highest new-class accuracy among the protected arms---so MAML+replay tops the balanced ranking}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces New-class accuracy versus number of support clips. MAML's advantage is largest at \textbf  {1 clip} (MAML 0.26 while every other init is near 0) and narrows as clips grow---meta-learning helps most exactly when data is scarce.}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:sweep}{{5}{4}{New-class accuracy versus number of support clips. MAML's advantage is largest at \textbf {1 clip} (MAML 0.26 while every other init is near 0) and narrows as clips grow---meta-learning helps most exactly when data is scarce}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces MAML meta-training curve: meta query accuracy rises from 0.83 to 0.98 over 8 epochs, confirming the initialisation is genuinely being shaped, not left at the student's starting point.}}{4}{figure.6}\protected@file@percent }
\newlabel{fig:metacurve}{{6}{4}{MAML meta-training curve: meta query accuracy rises from 0.83 to 0.98 over 8 epochs, confirming the initialisation is genuinely being shaped, not left at the student's starting point}{figure.6}{}}
